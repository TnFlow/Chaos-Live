{
  "event_rules": [
    {
      "id": "rule-gift-rose",
      "name": "Gift: Rose -> Summon Chicken",
      "enabled": true,
      "priority": 10,
      "cooldownMs": 500,
      "matcher": {
        "eventTypes": ["gift"],
        "metadataMatch": {
          "giftName": "Rose"
        }
      },
      "action": {
        "actionType": "execute_command",
        "command": "summon chicken ~ ~1 ~ {CustomName:'\"${user.displayName}\"'}"
      }
    },
    {
      "id": "rule-gift-icecream",
      "name": "Gift: Ice Cream -> Summon Zombie",
      "enabled": true,
      "priority": 25,
      "cooldownMs": 1000,
      "matcher": {
        "eventTypes": ["gift"],
        "metadataMatch": {
          "giftName": "Ice Cream"
        }
      },
      "action": {
        "actionType": "execute_command",
        "command": "summon zombie ~ ~ ~ {CustomName:'\"${user.displayName}\"'}"
      }
    },
    {
      "id": "rule-gift-lion",
      "name": "Gift: Lion -> Summon Creeper",
      "enabled": true,
      "priority": 100,
      "cooldownMs": 0,
      "matcher": {
        "eventTypes": ["gift"],
        "metadataMatch": {
          "giftName": "Lion"
        }
      },
      "action": {
        "actionType": "execute_command",
        "command": "summon creeper ~ ~ ~ {powered:1b,CustomName:'\"MEGA DONATION: ${user.displayName}\"'}"
      }
    },
    {
      "id": "rule-likes",
      "name": "Likes -> Particle Effect",
      "enabled": true,
      "priority": 5,
      "cooldownMs": 2000,
      "matcher": {
        "eventTypes": ["like"]
      },
      "action": {
        "actionType": "execute_command",
        "command": "particle heart ~ ~1 ~ 0.5 0.5 0.5 0.1 5"
      }
    },
    {
      "id": "rule-follow",
      "name": "Follow -> Welcome Title",
      "enabled": true,
      "priority": 15,
      "cooldownMs": 1000,
      "matcher": {
        "eventTypes": ["follow"]
      },
      "action": {
        "actionType": "send_title",
        "command": "title @a subtitle {\"text\":\"New follower: ${user.displayName}!\",\"color\":\"gold\"}"
      }
    },
    {
      "id": "rule-comment",
      "name": "Chat -> In-Game Chat",
      "enabled": true,
      "priority": 2,
      "cooldownMs": 500,
      "matcher": {
        "eventTypes": ["comment"]
      },
      "action": {
        "actionType": "send_chat",
        "command": "tellraw @a [{\"text\":\"[TikTok] \",\"color\":\"aqua\"},{\"text\":\"${user.displayName}: \",\"color\":\"white\"},{\"text\":\"${metadata.text}\",\"color\":\"gray\"}]"
      }
    }
  ]
}
