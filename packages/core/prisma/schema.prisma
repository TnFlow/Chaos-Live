generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  plan        String   @default("free") // "free", "creator", "pro"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials StreamerCredential[]

  @@index([slug])
}

model StreamerCredential {
  id           String    @id @default(uuid())
  tenantId     String
  platform     String    // "twitch", "tiktok", "youtube"
  accessToken  String
  refreshToken String?
  tokenExpires DateTime?
  channelId    String?
  channelName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, platform])
}

model Goal {
  id            String   @id @default(uuid())
  tenantId      String   @default("default")
  name          String
  eventType     String   // e.g. "gift", "like"
  targetValue   Int
  currentValue  Int      @default(0)
  actionCommand String
  actionType    String   @default("execute_command")
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, eventType, completed])
}

model ProcessedEvent {
  id               String   @id // correlationId (ChaosEvent.id)
  tenantId         String   @default("default")
  platform         String
  eventType        String
  userId           String
  userDisplayName  String
  value            Int
  actionDispatched Boolean  @default(false)
  command          String?
  success          Boolean  @default(false)
  error            String?
  durationMs       Int?
  createdAt        DateTime @default(now())

  @@index([tenantId, eventType, createdAt])
}

model SessionStat {
  id            String    @id @default(uuid())
  tenantId      String    @default("default")
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  totalEvents   Int       @default(0)
  totalGifts    Int       @default(0)
  totalDiamonds Int       @default(0)

  @@index([tenantId])
}
