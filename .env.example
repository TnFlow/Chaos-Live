# =============================================================================
# Chaos-Live — Configuración
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el archivo .env al repositorio.
# =============================================================================

# --- TikTok LIVE ---
# Nombre de usuario de TikTok al que conectarse (sin la @).
# Si lo dejas con el valor de ejemplo, Chaos-Live arranca en modo simulación.
TIKTOK_USERNAME=your_tiktok_username

# --- Minecraft RCON (respaldo) ---
# Solo hace falta si NO usas el mod de Fabric. Con el mod conectado, esto se ignora.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password

# --- Aplicación ---
# Nivel de detalle del log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Puerto del servidor (overlay, panel, API y conexión del mod)
WS_PORT=8080

# Interfaz de red en la que escuchar.
# 127.0.0.1 = solo este PC (recomendado).
# ATENCIÓN: la API de gestión NO tiene autenticación. Poner 0.0.0.0 permite que
# cualquiera en tu red local cambie tus reglas o dispare acciones en el juego.
HOST=127.0.0.1

# --- Registro en archivo ---
# Guardar los logs en disco para poder revisar qué pasó después de un directo.
# LOG_TO_FILE=false lo desactiva. Se crea un archivo por día.
LOG_TO_FILE=true
LOG_DIR=./logs

# --- Base de datos ---
DATABASE_URL=file:./chaos-live.db

# --- Overlay (superficie publica) ---
# El overlay se sirve en su propio puerto, separado del panel de gestion.
#
# Esa separacion no es cosmetica: la API de gestion NO tiene autenticacion, y
# quien la alcance puede ejecutar comandos en tu partida. En este puerto solo
# viven los estaticos del overlay y unas pocas lecturas, asi que es el unico
# que puede llegar a salir del PC.
OVERLAY_PORT=8081

# Interfaz del puerto publico. Dejalo en 127.0.0.1 mientras TikTok LIVE Studio
# consiga cargar los widgets desde el propio PC. Ponlo a 0.0.0.0 solo si TLS
# rechaza las URLs locales y necesitas alcanzarlo desde la red.
# OVERLAY_HOST=127.0.0.1

# Cada widget es una fuente "Link" distinta en TikTok LIVE Studio. El panel
# (pestana Overlay Studio) lista los ocho enlaces con su tamano de capa.
