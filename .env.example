# =============================================================================
# Chaos-Live — Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# --- TikTok LIVE ---
# The TikTok username to connect to (without @)
TIKTOK_USERNAME=your_tiktok_username

# --- Minecraft RCON (MVP) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password

# --- Application ---
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# WebSocket server port (overlay + future mod connections)
WS_PORT=8080

# --- Database ---
DATABASE_URL=file:./chaos-live.db

# --- Overlay ---
# Base URL for the overlay (used by OBS Browser Source)
OVERLAY_URL=http://localhost:8080/overlay
