# Normalize line endings to LF on commit, checkout as native
* text=auto eol=lf

# Ensure these are always LF
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary

# Lanzadores de Windows: deben llegar al disco con CRLF.
# cmd.exe puede fallar al saltar a etiquetas (goto) en ficheros con finales de
# linea LF, y estos .bat son la unica forma que tiene el streamer de arrancar.
# Con eol=crlf el repo guarda LF y la copia de trabajo recibe CRLF siempre.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
